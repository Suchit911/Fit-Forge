# ==============================================================================
# AI FITNESS FRONTEND — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env.local' in the project root to configure your frontend.
# These variables are public client-side parameters used by the Firebase Web SDK.
# DO NOT put backend secrets or service-account private keys here!
# ==============================================================================

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
