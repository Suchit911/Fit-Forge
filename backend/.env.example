# ==============================================================================
# AI FITNESS BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' in the backend/ directory to configure your environment.
# DO NOT commit the actual '.env' file or any service account JSON files to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="AI FITNESS API"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
PORT=8000
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 2. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# Vite dev server typically runs at http://localhost:5173
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 3. FIREBASE CONFIGURATION (BACKEND)
# ------------------------------------------------------------------------------
# Required for Firebase Admin SDK to verify Auth ID tokens and access Firestore.
#
# HOW TO OBTAIN:
# 1. Open Google Firebase Console: https://console.firebase.google.com/
# 2. Select your AI FITNESS project.
# 3. Go to Project Settings (gear icon) > Service accounts tab.
# 4. Under "Firebase Admin SDK", select Python and click "Generate new private key".
# 5. Save the downloaded JSON file securely inside backend/credentials/ (e.g. serviceAccountKey.json).
# 6. Set FIREBASE_SERVICE_ACCOUNT_PATH to the relative or absolute path of this file.
#
# NOTE: If FIREBASE_SERVICE_ACCOUNT_PATH is left empty, the backend runs in local
# fallback mode for foundation testing without crashing.
FIREBASE_PROJECT_ID="ai-fitness-app-placeholder"
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_STORAGE_BUCKET=""

# ------------------------------------------------------------------------------
# 4. FRONTEND FIREBASE CONFIGURATION REFERENCE (informational only)
# ------------------------------------------------------------------------------
# These client-side keys belong in the FRONTEND .env (prefixed with VITE_).
# They are public API keys used by Firebase Web SDK, NOT backend secrets.
# NEVER put backend service account private keys into frontend VITE_* variables!
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
